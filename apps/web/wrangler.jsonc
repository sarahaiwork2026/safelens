{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safelens",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"],
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safelens",
      "database_id": "348aa82c-4bd9-4a5a-abac-536f6b55cf7b",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "EXTRACTOR_CHAIN": "groq,rules",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "LLM_DAILY_BUDGET": "800",
    "NOMINATIM_USER_AGENT": "SafeLens/0.1 (sarah.aiwork2026@gmail.com)",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "workers_dev": true,
}
