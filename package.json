{
  "name": "safelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsx scripts/check-copy-and-style.ts",
    "test": "vitest run && pnpm --filter web test:worker",
    "test:e2e": "pnpm --filter web test:e2e",
    "perf": "tsx scripts/check-bundle.ts && pnpm --filter web perf",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:migrate:remote": "pnpm --filter web db:migrate:remote",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:reset:remote": "tsx scripts/remote-reset.ts",
    "eval:llm": "tsx scripts/eval-llm.ts",
    "snapshot": "tsx scripts/build-demo-snapshot.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "deploy": "pnpm build && pnpm --filter web deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
